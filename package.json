{
  "name": "zodstore",
  "version": "0.4.1",
  "type": "module",
  "description": "Native SQLite + Zod document-store library for Bun",
  "keywords": [
    "bun",
    "sqlite",
    "zod",
    "document-store",
    "database",
    "typescript"
  ],
  "license": "MIT",
  "author": "Enrico Scherlies",
  "homepage": "https://github.com/binaryplease/zodstore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/binaryplease/zodstore.git"
  },
  "bugs": {
    "url": "https://github.com/binaryplease/zodstore/issues"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/index.ts --outdir dist --target bun"
  },
  "peerDependencies": {
    "zod": "^3.24.0 || ^4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "typescript": "^5.7",
    "zod3": "npm:zod@^3.24.0"
  }
}
